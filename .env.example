# Copy to .env (git-ignored) and fill in. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Max /ask requests per client IP per hour (0 disables the limit)
RATE_LIMIT_PER_HOUR=30
# Set to true behind a trusted proxy (e.g. Render) to read the client IP from X-Forwarded-For
TRUST_FORWARDED_FOR=false
