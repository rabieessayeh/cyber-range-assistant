{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rabieessayeh/cyber-range-assistant/schema/scenario.schema.json",
  "title": "Cyber range training scenario",
  "description": "Planning-level description of a cyber range exercise mapped to MITRE ATT&CK Enterprise. It lists objectives, environment, ATT&CK-mapped steps, expected detections and trainee tasks; it never contains attack procedures, commands or code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "level", "audience", "duration_minutes", "objectives", "environment", "steps"],
  "properties": {
    "id": {"type": "string", "pattern": "^SCN-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "attack_version": {"type": "string", "description": "ATT&CK Enterprise release the mapping was made against"},
    "level": {"enum": ["beginner", "intermediate", "advanced"]},
    "audience": {"enum": ["soc-analyst", "blue-team", "red-team", "purple-team", "management"]},
    "duration_minutes": {"type": "integer", "minimum": 15, "maximum": 2880},
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments"],
      "properties": {
        "preset": {"type": "string"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hosts"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/host"}
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "os", "role"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "os": {"enum": ["Windows", "Linux", "macOS"]},
        "role": {
          "enum": ["attacker", "web-server", "mail-server", "workstation", "domain-controller", "file-server", "database", "siem"]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "tactic", "technique", "description", "target_host", "duration_minutes", "expected_detections", "trainee_tasks"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]+$"},
        "title": {"type": "string", "minLength": 3},
        "tactic": {"type": "string", "pattern": "^[a-z]+(-[a-z]+)*$", "description": "ATT&CK tactic shortname"},
        "technique": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
        "description": {"type": "string", "minLength": 3},
        "target_host": {"type": "string"},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
        "expected_detections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"},
          "description": "ATT&CK data component names expected to record this step"
        },
        "trainee_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
